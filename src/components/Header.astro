---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
import { url } from "@lib/utils";

// The links in the header. `url()` adds the site's base path (see astro.config.mjs).
const nav = [
  { href: url(), label: "About" },
  { href: url("full_page_map"), label: "Evidence map" },
];
---

<header>
  <Container>
    <div class="flex flex-wrap gap-x-6 gap-y-2 justify-between items-center">
      <Link href={url()} underline={false}>
        <div class="font-semibold">
          {SITE.NAME}
        </div>
      </Link>
      <nav class="hidden sm:flex gap-4 text-sm">
        {nav.map((item) => <Link href={item.href} underline={false}>{item.label}</Link>)}
      </nav>
    </div>
  </Container>
</header>
