---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { HOME } from "@consts";
import { url } from "@lib/utils";
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <p class="animate text-sm tracking-wide text-stone-500">An evolving map study by Mere Cui</p>
    <div class="space-y-8">
      <h1 class="font-serif text-black dark:text-white">The Temporary Forest</h1>
      <p>
        Vacant land is often recorded as a single administrative category. This
        project asks what becomes visible when that category is read through
        time, vegetation, and parcel-scale evidence.
      </p>
      <p><a class="text-lg" href={url("assignment_04")}>Enter the interactive field index</a></p>
      <p><a href={url("full_page_map")}>Tutorial 8.2 and 8.3 evidence map</a></p>
      <p class="max-w-2xl text-sm text-stone-500">
        This tutorial view uses a purposive sample of fourteen East New York
        parcels. It is not a census of vacant land and does not treat vegetation
        response as proof of habitat quality.
      </p>
    </div>
  </Container>
</PageLayout>
